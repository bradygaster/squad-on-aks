@page "/"

<!-- THESIS: A focused workspace for building with a team, not a promotional app builder.
OWN-WORLD: GitHub product conventions: neutral surfaces, blue links, green primary actions, compact system type and bordered sections.
STORY: Open an app, describe the work, build from the saved brief, inspect the result and revisit waves. Team setup remains automatic.
FIRST VIEWPORT: App header and section navigation above a preview/work column and a real team/activity sidebar. Root is an explicit app list.
FORM: Restrained light/dark interface, document flow, responsive sidebar, no mural, decorative notices or invented activity. -->
<PageTitle>Squad — Apps</PageTitle>

<a class="skip-link" href="#main">Skip to content</a>
<header class="appbar">
    <a class="brand" href="/" data-enhance-nav="false" aria-label="Squad home">
        <svg class="brand-mark" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2.5" y="2.5" width="7" height="7" rx="2" /><rect x="14.5" y="2.5" width="7" height="7" rx="2" /><rect x="8.5" y="14.5" width="7" height="7" rx="2" /><path d="M6 10v2h12v-2M12 12v2" /></svg>
        Squad
    </a>
    <span class="header-separator" aria-hidden="true">/</span>
    <a class="header-apps" href="/" data-enhance-nav="false">Apps</a>
    <span id="team-status" role="status">Connecting…</span><span id="wait-clock" class="wait-clock" hidden></span>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme"><span class="theme-glyph" aria-hidden="true">☾</span><span class="theme-label">Dark</span></button>
</header>
<main id="main" class="shell">
    <p id="notice" class="notice" role="alert" hidden></p>
    <section id="library" class="library" aria-labelledby="library-heading">
        <div class="section-heading"><div><h1 id="library-heading">Apps</h1><p>Build with a dedicated team. Keep each app’s work and history in one place.</p></div><div class="actions"><button id="import-app" type="button" class="secondary" aria-haspopup="dialog">Start from a repo</button><button id="create-app" type="button">New app</button></div></div>
        <p id="library-loading" role="status">Loading apps…</p>
        <div id="library-notice" class="library-notice" role="status" hidden></div>
        <ul id="app-library" class="app-library" aria-label="Apps"></ul>
    </section>
    <div id="project-view" hidden>
        <header class="project-heading">
            <h1 id="idea-heading">New app</h1>
            <p id="idea-description">Describe what you want to build. Your team will plan the work and build from your brief.</p>
        </header>
        <nav class="project-nav" aria-label="App sections">
            <a href="#app-overview" aria-current="location">Overview</a>
            <a id="jump-to-wave" href="#next-wave" hidden>Waves</a>
            <a href="#topology-section">Topology</a>
            <a href="#activity-section">Activity</a>
            <a href="#team-section">Team</a>
        </nav>
        <div class="workspace-layout">
            <div class="workspace-main">
                <section id="app-overview" aria-label="App overview">
                    <section id="casting-controls" class="request-panel" aria-label="Plan your app">
                        <div id="startup-input">
                            <label for="casting-prompt">Describe your app</label>
                            <textarea id="casting-prompt" rows="3" placeholder="A book-swap app where neighbors can list books and request a trade…" aria-describedby="casting-prompt-error"></textarea>
                            <p id="casting-prompt-error" class="field-error" hidden></p>
                            <div id="prompt-ideas" class="prompt-ideas" role="group" aria-labelledby="prompt-ideas-label">
                                <span id="prompt-ideas-label">Start from an idea</span>
                                <button type="button" class="secondary" data-idea="tools">Tool-lending library</button>
                                <button type="button" class="secondary" data-idea="recipes">Recipe box</button>
                                <button type="button" class="secondary" data-idea="standup">Team standup board</button>
                                <button type="button" class="secondary" data-idea="surprise">Surprise me</button>
                            </div>
                            <div class="actions"><button id="send-casting-turn" type="button">Plan app</button></div>
                        </div>
                        <p id="casting-hint">Start with the goal and who will use it.</p>
                        <div id="startup-brief" hidden>
                            <h2>App brief</h2>
                            <p id="startup-summary"></p>
                            <p id="startup-question" role="status" hidden></p>
                            <div id="startup-answer" class="startup-answer" hidden>
                                <label for="startup-answer-text">Your answer</label>
                                <textarea id="startup-answer-text" rows="2" placeholder="Type your answer, or say “no preference”." aria-describedby="startup-answer-error"></textarea>
                                <p id="startup-answer-error" class="field-error" hidden></p>
                                <div class="actions"><button id="send-startup-answer" type="button">Send answer</button></div>
                            </div>
                            <div class="actions"><button id="build-app" type="button">Build my app</button></div>
                            <p id="startup-note">Build from this brief, or add details above.</p>
                        </div>
                    </section>
                    <details id="activity-section" class="activity-section">
                        <summary><span id="activity-heading">Activity</span><span id="activity-context">Planning and team setup</span><span id="activity-status">Waiting</span></summary>
                        <div class="activity-content">
                            <p id="activity-note">Task assignments, requested tools and saved changes. Repeated updates are grouped. Private reasoning and execution output are not shown.</p>
                            <p id="activity-error" class="field-error" hidden>Activity couldn’t be loaded. The next update will retry; your app is still available.</p>
                            <p id="activity-empty">Waiting for recorded activity. Events appear as your team reports them.</p>
                            <ol id="activity-list" class="activity-list" aria-label="Recorded activity"></ol>
                            <p id="activity-limit" hidden>Showing the latest 30 activity entries for this view.</p>
                        </div>
                    </details>
                    <section class="viewing-window" id="viewing-window" aria-label="App preview">
                        <div class="window-top"><h2>Preview</h2><span id="preview-status" role="status">No preview yet</span></div>
                        <div class="window-empty" id="preview-empty">
                            <svg class="window-art" viewBox="0 0 48 48" fill="none" aria-hidden="true"><rect x="5" y="8" width="38" height="32" rx="4" /><path d="M5 17h38M11 12.5h1M16 12.5h1M21 12.5h1M19 24l-5 5 5 5M29 24l5 5-5 5" /></svg>
                            <h3 id="preview-empty-title">Your app preview will appear here</h3>
                            <p id="preview-empty-note">Plan your app, then start a build. The preview becomes available when there’s a result to open.</p>
                        </div>
                        <iframe id="app-preview" title="Your app preview" sandbox="allow-scripts allow-forms allow-popups allow-modals" hidden></iframe>
                        <div class="window-bottom"><span id="preview-caption">Waiting for the first build.</span><a id="open-app" href="#" target="_blank" rel="noopener" aria-disabled="true">Open app <span class="visually-hidden">(opens in a new tab)</span><span aria-hidden="true">↗</span></a></div>
                    </section>
                    <section id="topology-section" class="topology-section" aria-labelledby="topology-heading">
                        <div class="window-top">
                            <h2 id="topology-heading">Topology</h2>
                            <span id="topology-state" class="topology-state" role="status">Planned</span>
                        </div>
                        <div class="topology-toolbar">
                            <div class="segmented" role="group" aria-label="Topology view">
                                <button type="button" class="secondary" data-topology-view="aspire" aria-pressed="true">Aspire</button>
                                <button type="button" class="secondary" data-topology-view="cluster" aria-pressed="false">Cluster</button>
                            </div>
                            <p id="topology-note">How your team builds this app in Aspire.</p>
                            <span id="topology-live" class="topology-live" hidden></span>
                        </div>
                        <div id="topology-diagram" class="topology-diagram"><p class="topology-loading">Loading topology…</p></div>
                        <details id="pipeline-section" class="pipeline-section">
                            <summary><span>What’s happening</span><span id="pipeline-summary">No deployments yet</span></summary>
                            <p id="pipeline-note">Recorded build and deployment steps for this app. Logs and command output are not shown.</p>
                            <ol id="pipeline-steps" class="pipeline-steps" aria-label="Deployment steps"></ol>
                            <h3 id="pipeline-history-heading" hidden>Earlier revisions</h3>
                            <ol id="pipeline-history" class="pipeline-history" aria-labelledby="pipeline-history-heading" hidden></ol>
                        </details>
                    </section>
                </section>
                <section id="making" class="making" aria-label="App work" hidden>
                    <article id="wave-notice" class="wave-detail" aria-labelledby="evidence-heading" hidden>
                        <div class="notice-heading"><h2 id="evidence-heading">Wave 1</h2><span id="wave-state" class="badge"></span></div>
                        <time id="wave-date"></time><h3 id="wave-objective"></h3>
                        <p id="wave-result" aria-live="polite"></p>
                        <section id="wave-story" class="wave-story" aria-labelledby="wave-story-heading" hidden>
                            <h4 id="wave-story-heading">Team summary</h4>
                            <ul id="wave-highlights"></ul>
                        </section>
                        <section id="wave-next" class="wave-next" aria-labelledby="wave-next-heading" hidden>
                            <h4 id="wave-next-heading">Your team suggests</h4>
                            <div id="wave-next-ideas" class="wave-next-ideas"></div>
                        </section>
                        <ul id="wave-proof" aria-label="Work results"></ul>
                        <section id="wave-fix" class="wave-fix" aria-labelledby="wave-fix-heading" hidden>
                            <h4 id="wave-fix-heading">What the checks found</h4>
                            <ul id="wave-findings"></ul>
                            <button id="ask-fix" type="button" class="secondary">Ask the team to fix this</button>
                        </section>
                        <div id="wave-team" class="wave-team" hidden><h3>Contributors</h3><ul id="wave-contributors" aria-label="Contributors to this wave"></ul></div>
                        <a id="wave-try" class="button secondary" href="#" target="_blank" rel="noopener" hidden>Open app <span class="visually-hidden">(opens in a new tab)</span><span aria-hidden="true">↗</span></a>
                    </article>
                    <section id="next-wave" class="next-wave" aria-labelledby="work-heading">
                        <h2 id="work-heading">Start the next wave</h2>
                        <p>Describe a focused change. Each wave keeps its request, outcome and results.</p>
                        <label for="work-request">What would you like to change?</label>
                        <textarea id="work-request" rows="3" placeholder="Let people filter available books by genre…" aria-describedby="work-request-error" disabled></textarea>
                        <p class="field-error" id="work-request-error" hidden></p>
                        <div id="ask-before-fix-field" class="check-field" hidden><input id="ask-before-fix" type="checkbox" aria-describedby="ask-before-fix-note" /><label for="ask-before-fix">Ask me before fixing automatically</label><p id="ask-before-fix-note">When a version is held back before going online, your team fixes it in up to two waves on its own unless you check this.</p></div>
                        <div class="actions"><button id="send-work" type="button" disabled>Start a wave</button><button id="cancel-work" type="button" class="secondary" hidden>Stop this wave</button></div>
                        <p class="shortcut">Ctrl or ⌘ + Enter to submit.</p>
                    </section>
                </section>
                <section class="keep-section" id="keep-section" aria-labelledby="keep-heading" hidden>
                    <h2 id="keep-heading">Share and export</h2>
                    <p id="online-note" role="status"></p>
                    <div id="share-topology" class="share-topology" role="group" aria-label="Deployed topology" hidden></div>
                    <div class="actions"><button type="button" id="put-online" disabled>Put it online</button><a class="button secondary" id="download-zip" href="/workspace/export.zip" download>Download ZIP</a><button type="button" id="toggle-publish" class="secondary" aria-haspopup="dialog">Publish to GitHub</button><button type="button" id="send-branch" class="secondary" hidden>Send to GitHub</button></div>
                    <p id="send-result" role="status" hidden></p>
                </section>
                <section class="delete-section" id="delete-section" aria-labelledby="delete-heading" hidden>
                    <h2 id="delete-heading">Delete app</h2>
                    <p>Removes this app, its team and its waves, and takes it offline along with its data.</p>
                    <button type="button" id="delete-app" class="danger" aria-haspopup="dialog">Delete app…</button>
                </section>
            </div>
            <aside class="workspace-sidebar" aria-label="Team and history">
                <section id="team-section" class="team-section" aria-labelledby="team-heading">
                    <div class="sidebar-heading"><h2 id="team-heading">Team</h2><span id="member-count" class="counter" hidden></span></div>
                    <p id="team-description">A team is created for this app when you start its first build.</p>
                    <p id="team-error" class="field-error" role="status" hidden></p>
                    <ul id="team-members" class="team-members" aria-label="App team"></ul>
                </section>
                <section class="wave-history" aria-labelledby="waves-heading"><h2 id="waves-heading">Waves</h2><p id="waves-empty">No waves yet. Start a build to create the first one.</p><ol id="wave-list" class="wave-list" aria-label="Wave timeline"></ol></section>
            </aside>
        </div>
    </div>
    <footer class="page-footer"><span>Squad</span><p>A team for every app.</p><a href="/" data-enhance-nav="false">All apps</a></footer>
</main>
<dialog id="delete-dialog" aria-labelledby="delete-dialog-heading" aria-describedby="delete-explanation">
    <form id="delete-form" novalidate><h2 id="delete-dialog-heading">Delete this app?</h2><p id="delete-explanation">This removes the app, its team, its waves and its files, and takes it offline. Its data is deleted too. This can’t be undone.</p><div id="delete-repositories" hidden><p>This app was published to GitHub. Deleting it here doesn’t delete the repository:</p><ul id="delete-repository-list"></ul><p>Delete the repository on GitHub if you no longer need it.</p></div><p id="delete-result" class="field-error" role="status" hidden></p><div class="actions"><button id="delete-confirm" type="submit" class="danger">Delete app</button><button id="delete-cancel" type="button" class="secondary">Cancel</button></div></form>
</dialog>
<dialog id="import-dialog" aria-labelledby="import-heading" aria-describedby="import-explanation">
    <form id="import-form" novalidate><h2 id="import-heading">Start from a repo</h2><p id="import-explanation">Copy one of your GitHub repositories into a new app, then send waves of work to it. If the repository has a Squad, that team is used; otherwise you’ll describe the work and a team is set up for it.</p><div class="publish-fields"><div><label for="import-owner">Owner</label><select id="import-owner" disabled><option>Loading accounts…</option></select></div><div><label for="import-filter">Repository</label><input id="import-filter" autocomplete="off" spellcheck="false" placeholder="Filter repositories" /></div></div><ul id="import-repos" class="import-repos" aria-label="Repositories"></ul><p id="import-detail" role="status"></p><p id="import-result" class="field-error" role="alert" hidden></p><div class="actions"><button id="import-submit" type="submit" disabled>Start app</button><button id="import-cancel" type="button" class="secondary">Cancel</button></div></form>
</dialog>
<dialog id="publish-dialog" aria-labelledby="publish-heading" aria-describedby="publish-explanation">
    <form id="publish-form" novalidate><h2 id="publish-heading">Publish to GitHub</h2><p id="publish-explanation">Create a private repository for this app. Only you and the people you invite can see it.</p><p id="publish-auth"></p><div class="publish-fields"><div><label for="publish-owner">Whose account?</label><select id="publish-owner" disabled><option>Loading accounts…</option></select></div><div><label for="publish-name">Repository name</label><input id="publish-name" autocomplete="off" spellcheck="false" aria-describedby="publish-result" /></div></div><div class="actions"><button id="publish-submit" type="submit" disabled>Review publication</button><button id="publish-cancel" type="button" class="secondary">Close</button></div><section id="publish-review" hidden><h3>Confirm publication</h3><p id="publish-destination"></p><p>A new private repository will contain this app and its work history. Nothing you already own will be replaced.</p><div class="actions"><button id="publish-confirm" type="button">Publish my app</button><button id="publish-back" type="button" class="secondary">Back to details</button></div></section><p id="publish-result" aria-live="polite" tabindex="-1"></p></form>
</dialog>
