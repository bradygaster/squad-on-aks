@page "/"

<PageTitle>Squad on AKS</PageTitle>

<main class="shell">
    <header class="hero">
        <div class="eyebrow">Native Squad casting</div>
        <h1>Build your Squad.</h1>
        <p class="lede">
            Describe the work, refine the streamed proposal, then confirm before Squad writes its native team files.
        </p>
        <div class="lifecycle">
            <span class="status-dot" aria-hidden="true"></span>
            <strong role="status" aria-live="polite">Needs cast</strong>
        </div>
    </header>

    <div class="workspace">
        <section class="panel conversation-panel" aria-labelledby="casting-heading">
            <div class="panel-heading">
                <div>
                    <span class="step">01</span>
                    <h2 id="casting-heading">Cast conversation</h2>
                </div>
                <span class="transport">Squad.Agents.AI · AG-UI</span>
            </div>

            <label for="casting-prompt">What will this Squad do?</label>
            <textarea id="casting-prompt" rows="5"
                      placeholder="Maintain this route-planning service. Implement small changes, test them, and review every result."></textarea>
            <div class="actions">
                <button type="button" id="send-casting-turn">Propose cast</button>
                <button type="button" id="confirm-cast" class="secondary" disabled>Confirm this cast</button>
            </div>
            <p class="hint">Refinement stays in this conversation. No roster files are written until confirmation.</p>
            <div role="alert" aria-live="assertive"></div>
            <ol class="stream" aria-label="Cast conversation"></ol>
        </section>

        <section class="panel review-panel" aria-labelledby="review-heading">
            <div class="panel-heading">
                <div>
                    <span class="step">02</span>
                    <h2 id="review-heading">Cast review</h2>
                </div>
            </div>
            <p class="hint">Review is limited to native <code>team.md</code>, <code>routing.md</code>, and active charters.</p>
            <label for="review-file">Native file</label>
            <select id="review-file" disabled></select>
            <label for="review-content">Markdown</label>
            <textarea id="review-content" rows="16" disabled></textarea>
            <div class="actions">
                <button type="button" id="save-review" class="secondary" disabled>Save review edit</button>
                <button type="button" id="activate-cast" disabled>Start taking requests</button>
            </div>
            <ul class="validation-errors" aria-label="Validation errors"></ul>
        </section>
    </div>

    <section class="panel work-panel" aria-labelledby="work-heading">
        <div>
            <span class="step">03</span>
            <h2 id="work-heading">Work requests</h2>
            <p class="hint">Controls unlock only after the reviewed native cast validates and activates.</p>
        </div>
        <label for="work-request">Describe one bounded request for the active Squad.</label>
        <textarea id="work-request" rows="3" disabled
                  placeholder="Describe one bounded request for the active Squad."></textarea>
        <div class="actions">
            <button type="button" id="send-work" disabled>Send request</button>
            <button type="button" id="cancel-work" class="secondary" disabled>Cancel active work</button>
        </div>
    </section>
</main>
