@page "/"

<PageTitle>Squad on AKS</PageTitle>

<main class="shell">
    <header class="appbar">
        <div class="brand">
            <h1>Squad on AKS</h1>
            <p class="lede" id="phase-lede">Describe the work, refine the proposed cast, then confirm before Squad writes its team files.</p>
        </div>
        <div class="appbar-state">
            <div class="lifecycle">
                <span class="status-dot" aria-hidden="true"></span>
                <strong role="status" aria-live="polite">Needs cast</strong>
            </div>
            <span id="outcome-indicator" class="outcome neutral" aria-label="Run outcome">Idle</span>
        </div>
    </header>

    <div class="notice" role="alert" aria-live="assertive"></div>

    <section class="panel squad-roster" id="squad-roster" aria-labelledby="roster-heading" hidden>
        <div class="panel-heading">
            <div>
                <h2 id="roster-heading">Your Squad</h2>
                <p class="hint">The team active in this workspace.</p>
            </div>
        </div>
        <div class="roster-members" id="roster-members" aria-label="Squad members"></div>
        <p class="honesty-note">This team lives in this workspace. Publish to keep their work as real GitHub history.</p>
        <section class="specialist-profile" id="specialist-profile" aria-labelledby="profile-name" hidden>
            <header class="specialist-profile-heading">
                <div class="specialist-profile-identity">
                    <span class="roster-avatar profile-avatar" id="profile-avatar" aria-hidden="true"></span>
                    <div>
                        <h3 id="profile-name"></h3>
                        <p id="profile-role"></p>
                    </div>
                </div>
                <button type="button" class="secondary small" id="close-profile">Close profile</button>
            </header>
            <div class="profile-grid">
                <section aria-labelledby="profile-waves-heading">
                    <h4 id="profile-waves-heading">Waves</h4>
                    <ul id="profile-waves" aria-label="Waves this specialist participated in"></ul>
                </section>
                <section aria-labelledby="profile-evidence-heading">
                    <h4 id="profile-evidence-heading">Recent evidence</h4>
                    <ol id="profile-evidence" aria-label="Recent specialist evidence"></ol>
                </section>
            </div>
            <details id="profile-charter">
                <summary>View charter</summary>
                <div class="profile-charter-content">
                    <p id="profile-charter-path" hidden></p>
                    <div id="profile-charter-body" class="markdown"></div>
                    <p id="profile-charter-missing" hidden>No charter file is available for this member.</p>
                </div>
            </details>
        </section>
    </section>

    <details class="panel setup" id="setup" open>
        <summary>
            <span class="setup-title">Squad setup</span>
            <span class="setup-summary" id="setup-summary">Cast your Squad to unlock work requests.</span>
        </summary>

        <div class="workspace">
            <section class="conversation-panel" aria-labelledby="casting-heading">
                <div class="panel-heading">
                    <h2 id="casting-heading">Cast conversation</h2>
                    <span class="transport">Squad.Agents.AI · AG-UI</span>
                </div>

                <label for="casting-prompt">What will this Squad do?</label>
                <textarea id="casting-prompt" rows="4" aria-describedby="casting-prompt-error"
                          placeholder="Build a small browser game. Implement it in waves, test each change, and review every result."></textarea>
                <p class="field-error" id="casting-prompt-error" hidden></p>
                <div class="actions">
                    <button type="button" id="send-casting-turn">Propose cast</button>
                    <button type="button" id="confirm-cast" class="secondary" disabled>Confirm this cast</button>
                </div>
                <p class="hint" id="casting-hint">Refine as often as you like. No team files are written until you confirm.</p>
                <ol class="stream" aria-label="Cast conversation"></ol>
                <section class="proposal-roster" id="proposal-roster" aria-labelledby="proposal-roster-heading" hidden>
                    <h3 id="proposal-roster-heading">Proposed members</h3>
                    <ul id="proposal-members" aria-label="Proposed Squad members"></ul>
                </section>
            </section>

            <section class="review-panel" aria-labelledby="review-heading">
                <div class="panel-heading">
                    <h2 id="review-heading">Cast review</h2>
                </div>
                <p class="hint" id="review-hint">After you confirm, review <code>team.md</code>, <code>routing.md</code>, and each active charter here.</p>
                <label for="review-file">Native file</label>
                <select id="review-file" disabled></select>
                <label for="review-content">Markdown</label>
                <textarea id="review-content" rows="14" disabled></textarea>
                <div class="actions">
                    <button type="button" id="save-review" class="secondary" disabled>Save review edit</button>
                    <button type="button" id="activate-cast" disabled>Start taking requests</button>
                </div>
                <ul class="validation-errors" aria-label="Validation errors"></ul>
            </section>
        </div>
    </details>

    <div class="work-layout">
        <aside class="panel waves-panel" aria-labelledby="waves-heading">
            <div class="panel-heading">
                <h2 id="waves-heading" tabindex="-1">Waves</h2>
                <span class="count" id="wave-count">0</span>
            </div>
            <p class="hint empty-hint" id="waves-empty">Each request you send becomes a wave. Completed waves stay here so you can reopen them.</p>
            <ol class="wave-list" aria-label="Wave timeline"></ol>
        </aside>

        <div class="work-column">
            <section class="panel work-panel" aria-labelledby="work-heading">
                <div class="panel-heading">
                    <h2 id="work-heading">Next wave</h2>
                    <span class="hint" id="work-lock">Unlocks after the cast is activated.</span>
                </div>
                <label for="work-request">Describe one bounded request for the active Squad.</label>
                <textarea id="work-request" rows="3" disabled aria-describedby="work-request-error"
                          placeholder="Example: Add a pause button and keyboard shortcut, with tests."></textarea>
                <p class="field-error" id="work-request-error" hidden></p>
                <div class="actions">
                    <button type="button" id="send-work" disabled>Send request</button>
                    <button type="button" id="cancel-work" class="secondary" disabled>Cancel active work</button>
                    <span class="hint shortcut">⌘/Ctrl + Enter sends</span>
                </div>
            </section>

            <section class="panel evidence-panel" aria-labelledby="evidence-heading">
                <div class="panel-heading">
                    <div class="wave-title">
                        <h2 id="evidence-heading">No wave selected</h2>
                        <p class="wave-meta" id="wave-meta"></p>
                        <span id="wave-state" class="badge" hidden></span>
                        <p class="wave-checkpoint" id="wave-checkpoint"></p>
                    </div>
                </div>

                <div class="pr-layout">
                    <aside class="wave-specialists" aria-labelledby="wave-specialists-heading" hidden>
                        <h3 id="wave-specialists-heading">Specialists</h3>
                        <ol id="wave-specialists" aria-label="Wave specialists"></ol>
                    </aside>
                    <div class="pr-main">
                        <nav class="pr-tabs" role="tablist" aria-label="Wave details" hidden>
                            <button type="button" id="conversation-tab" role="tab" aria-controls="conversation-pane" aria-selected="true">Conversation <span class="tab-count" id="conversation-count">0</span></button>
                            <button type="button" id="checks-tab" role="tab" aria-controls="checks-pane" aria-selected="false" tabindex="-1">Checks <span class="tab-count" id="checks-count">0</span></button>
                            <button type="button" id="files-tab" role="tab" aria-controls="files-pane" aria-selected="false" tabindex="-1">Files changed <span class="tab-count" id="files-count">0</span></button>
                        </nav>
                        <section class="pr-pane" id="conversation-pane" role="tabpanel" aria-labelledby="conversation-tab">
                            <ol class="stream work-stream" aria-label="Work conversation"></ol>
                            <section class="pr-evidence" aria-labelledby="activity-heading" hidden>
                                <h3 id="activity-heading">Specialist activity</h3>
                                <ol class="evidence-list" aria-label="Specialist activity"></ol>
                            </section>
                        </section>
                        <section class="pr-pane" id="checks-pane" role="tabpanel" aria-labelledby="checks-tab" hidden>
                            <h3 id="validation-heading">Validation</h3>
                            <ol class="evidence-list" aria-label="Validation evidence"></ol>
                        </section>
                        <section class="pr-pane" id="files-pane" role="tabpanel" aria-labelledby="files-tab" hidden>
                            <h3 id="application-heading">Application changes</h3>
                            <ol class="evidence-list" aria-label="Application evidence"></ol>
                            <div class="application-diff" id="application-diff-pane" role="tabpanel" tabindex="0"></div>
                            <section class="pr-evidence" aria-labelledby="harness-heading">
                                <h3 id="harness-heading">Squad team changes</h3>
                                <ol class="evidence-list" aria-label="Harness evidence"></ol>
                            </section>
                        </section>
                    </div>
                </div>
            </section>
        </div>
        <aside class="panel activity-panel" id="activity-panel" aria-labelledby="activity-panel-heading">
            <div class="panel-heading">
                <h2 id="activity-panel-heading">Activity</h2>
            </div>
            <section aria-labelledby="working-heading">
                <h3 id="working-heading">Working</h3>
                <ul class="activity-items" id="working-items"></ul>
            </section>
            <section aria-labelledby="ready-heading">
                <h3 id="ready-heading">Ready to review</h3>
                <ul class="activity-items" id="ready-items"></ul>
            </section>
            <section aria-labelledby="outputs-heading">
                <h3 id="outputs-heading">Outputs</h3>
                <ul class="activity-items" id="output-items"></ul>
                <button type="button" class="secondary small" id="activity-publish">Publish to GitHub</button>
            </section>
        </aside>
    </div>

    <section class="panel artifacts-panel" aria-labelledby="artifacts-heading">
        <div class="panel-heading">
            <div>
                <h2 id="artifacts-heading">Artifacts</h2>
                <p class="hint" id="artifacts-summary">Everything the Squad writes to its workspace.</p>
            </div>
            <div class="actions artifact-actions">
                <a class="button secondary" id="open-app" href="#" target="_blank" rel="noopener" aria-disabled="true" aria-describedby="preview-scope">Open app</a>
                <a class="button secondary" id="download-zip" href="/workspace/export.zip" download aria-describedby="zip-scope">Download ZIP</a>
                <button type="button" id="toggle-publish" aria-expanded="false" aria-controls="publish-form" aria-describedby="publish-scope">Publish to GitHub</button>
            </div>
        </div>

        <div class="hint">
            <p id="preview-scope">Open app opens the generated static app preview in a new tab, not a deployed app.</p>
            <p id="zip-scope">Download ZIP includes current workspace files and Squad team/configuration files. It excludes Git history, .git, node_modules, symbolic links, and private Squad runtime state.</p>
            <p id="publish-scope">Publish to GitHub creates a new private repository in the account or organization you select, with workspace files and wave commit history.</p>
        </div>

        <form class="publish-form" id="publish-form" hidden aria-labelledby="publish-heading">
            <h3 id="publish-heading">Publish to a new GitHub repository</h3>
            <p class="hint" id="publish-auth">Publishing currently uses the server-configured GitHub credential, not an independent browser connection.</p>
            <div class="publish-fields">
                <div>
                    <label for="publish-owner">Owner</label>
                    <select id="publish-owner" disabled><option>Loading…</option></select>
                </div>
                <div>
                    <label for="publish-name">Repository name</label>
                    <input id="publish-name" type="text" autocomplete="off" spellcheck="false" aria-describedby="publish-result" />
                </div>
                <p>Private repository only</p>
            </div>
            <div class="actions">
                <button type="submit" id="publish-submit" disabled>Review publication</button>
                <button type="button" id="publish-cancel" class="secondary">Close</button>
            </div>
            <section id="publish-review" hidden aria-labelledby="publish-review-heading">
                <h4 id="publish-review-heading">Confirm publication</h4>
                <p id="publish-destination"></p>
                <p>This creates a new private repository and pushes the workspace and its wave commit history, including Squad team/configuration files. Private Squad runtime state is excluded. No existing repository will be overwritten.</p>
                <div class="actions">
                    <button type="button" id="publish-confirm" aria-describedby="publish-destination">Create private repository and push</button>
                    <button type="button" id="publish-back" class="secondary">Back to details</button>
                </div>
            </section>
            <p class="publish-result" id="publish-result" aria-live="polite"></p>
        </form>

        <div class="artifact-browser">
            <nav class="file-tree-panel" aria-label="Workspace files">
                <label for="file-filter" class="visually-hidden">Filter files</label>
                <input id="file-filter" type="search" placeholder="Filter files" autocomplete="off" />
                <div class="file-tree" id="file-tree"></div>
            </nav>
            <section class="file-viewer" aria-labelledby="file-heading">
                <div class="file-viewer-heading">
                    <h3 id="file-heading">Select a file</h3>
                    <div class="actions">
                        <button type="button" id="toggle-source" class="secondary small" hidden>View source</button>
                        <a class="button secondary small" id="raw-file" href="#" target="_blank" rel="noopener" hidden>Open raw</a>
                    </div>
                </div>
                <div class="file-body" id="file-body">
                    <p class="hint">Choose a file on the left to read it here. Code shows line numbers, Markdown renders, and images display inline.</p>
                </div>
            </section>
        </div>
    </section>
</main>
