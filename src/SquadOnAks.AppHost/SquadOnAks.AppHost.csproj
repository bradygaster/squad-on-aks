<Project Sdk="Aspire.AppHost.Sdk/13.6.5">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <!-- Aspire 13.6.5 defaults AspireUseCliBundle to false and then warns about that default (ASPIRE010).
         Keep the 13.4.3 behaviour (pinned local CLI tool, no bundle) rather than change orchestration in a security patch. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Azure.Kubernetes" />
    <PackageReference Include="Aspire.Hosting.Kubernetes" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="MessagePack.Annotations" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SquadOnAks.Web/SquadOnAks.Web.csproj" />
    <ProjectReference Include="../SquadOnAks.NamespaceProvisioner/SquadOnAks.NamespaceProvisioner.csproj" />
  </ItemGroup>
</Project>
