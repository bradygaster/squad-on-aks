#!/usr/bin/env python3
"""Write a Helm values file that fills the Aspire chart's generated secret parameters.

Aspire publishes parameters such as the PostgreSQL password as empty values (for example
secrets.db.db_password and secrets.api.db_password). Each parameter gets one random value
the first time the app is deployed. Later revisions reuse the value already stored in the
release, so an update never locks the API out of the database it created.

Usage: secret-values <package.tgz> <release> <namespace> <output.json>
Prints nothing; never writes a value to stdout or stderr.
"""
import json
import re
import secrets
import subprocess
import sys
import tarfile

SECRET_KEY = re.compile(r"^[A-Za-z0-9_]*password$", re.IGNORECASE)


def chart_secret_keys(package):
    """(component, key) pairs under the chart's top-level `secrets:` map that hold passwords."""
    with tarfile.open(package, "r:gz") as archive:
        member = next((m for m in archive.getmembers()
                       if m.isfile() and m.name.count("/") == 1 and m.name.endswith("/values.yaml")), None)
        if member is None:
            return []
        text = archive.extractfile(member).read(256 * 1024).decode("utf-8")
    keys, section, component = [], None, None
    for line in text.splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        indent = len(line) - len(line.lstrip(" "))
        name = line.strip().split(":", 1)[0].strip().strip('"')
        if indent == 0:
            section, component = name, None
        elif indent == 2:
            component = name
        elif indent == 4 and section == "secrets" and component and SECRET_KEY.match(name):
            keys.append((component, name))
    return keys


def existing_values(release, namespace):
    result = subprocess.run(
        ["helm", "get", "values", release, "--namespace", namespace, "--output", "json"],
        capture_output=True, text=True, check=False)
    if result.returncode != 0:
        return {}
    try:
        return json.loads(result.stdout) or {}
    except json.JSONDecodeError:
        return {}


def main(package, release, namespace, output):
    keys = chart_secret_keys(package)
    stored = existing_values(release, namespace).get("secrets", {})
    # One value per parameter name: the database and the API share db_password.
    chosen = {}
    for component, key in keys:
        value = (stored.get(component) or {}).get(key)
        if isinstance(value, str) and value:
            chosen.setdefault(key, value)
    values = {"secrets": {}}
    for component, key in keys:
        value = chosen.setdefault(key, secrets.token_urlsafe(24))
        values["secrets"].setdefault(component, {})[key] = value
    with open(output, "w", encoding="utf-8") as handle:
        json.dump(values, handle)


if __name__ == "__main__":
    if len(sys.argv) != 5:
        sys.exit("usage: secret-values <package.tgz> <release> <namespace> <output.json>")
    main(*sys.argv[1:])
