#!/bin/sh
set -eu
: "${SOAKS_REGISTRY_PUSH:?local proof registry push endpoint required}"
: "${SOAKS_REGISTRY_PULL:?local proof registry pull endpoint required}"
mkdir -p "$HOME"
# Arguments: upgrade --install <release> <package> --namespace <namespace> ...
release="$3"
namespace="$6"
test "$5" = "--namespace"
# One image per project (image-<resource>.tar.gz); an older build's single image.tar.gz is the api project.
images=""
for archive in /artifacts/image-*.tar.gz /artifacts/image.tar.gz; do
    [ -f "$archive" ] || continue
    name="$(basename "$archive" .tar.gz)"
    name="${name#image}"
    name="${name#-}"
    [ -n "$name" ] || name=api
    case "$name" in *[!a-z0-9]*) echo "Blocked: unexpected image archive $archive." >&2; exit 2 ;; esac
    case " $images " in *" $name "*) continue ;; esac
    digest="$(sha256sum "$archive" | cut -d ' ' -f 1)"
    rm -rf /tmp/image && mkdir -p /tmp/image
    tar --no-same-owner -xf "$archive" -C /tmp/image
    if [ -n "${SOAKS_REGISTRY_USERNAME:-}" ]; then
        # A real registry: TLS verified, scoped push token (never echoed).
        skopeo --tmpdir /tmp copy --dest-creds "$SOAKS_REGISTRY_USERNAME:$SOAKS_REGISTRY_PASSWORD" oci:/tmp/image \
            "docker://$SOAKS_REGISTRY_PUSH/soaks/$release-$name:$digest"
    else
        skopeo --tmpdir /tmp copy --dest-tls-verify=false oci:/tmp/image \
            "docker://$SOAKS_REGISTRY_PUSH/soaks/$release-$name:$digest"
    fi
    set -- "$@" --set-string "parameters.$name.${name}_image=$SOAKS_REGISTRY_PULL/soaks/$release-$name:$digest" \
        --set-string "config.$name.HTTP_PORTS=8080"
    images="$images $name"
done
case " $images " in *" api "*) ;; *) echo "Blocked: the build produced no api image." >&2; exit 2 ;; esac
# Fill Aspire's generated secret parameters (the PostgreSQL passwords) once and reuse them on updates.
umask 077
/worker/secret-values /artifacts/package.tgz "$release" "$namespace" /tmp/secret-values.json
exec helm "$@" --values /tmp/secret-values.json
