#!/bin/sh
set -eu
: "${DAYDREAM_REGISTRY_PUSH:?local proof registry push endpoint required}"
: "${DAYDREAM_REGISTRY_PULL:?local proof registry pull endpoint required}"
mkdir -p "$HOME" /tmp/image
digest="$(sha256sum /artifacts/image.tar.gz | cut -d ' ' -f 1)"
repository="daydream/$3"
tar --no-same-owner -xf /artifacts/image.tar.gz -C /tmp/image
skopeo --tmpdir /tmp copy --dest-tls-verify=false oci:/tmp/image \
    "docker://$DAYDREAM_REGISTRY_PUSH/$repository:$digest"
image="$DAYDREAM_REGISTRY_PULL/$repository:$digest"
exec helm "$@" --set-string "parameters.api.api_image=$image" \
    --set-string config.api.HTTP_PORTS=8080
